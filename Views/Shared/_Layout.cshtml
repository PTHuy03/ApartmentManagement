@using System.Security.Claims
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ApartmentManagement</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ApartmentManagement.styles.css" asp-append-version="true" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand ms-2 fs-3" asp-controller="Room" asp-action="Index">Lucky House</a>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <div class="d-flex align-items-center flex-grow-1 me-4">
                        <input type="text" id="searchInput" name="search"
                               class="form-control w-50 rounded-end-0"
                               style="min-width: 300px;"
                               placeholder="Search by room name..." />
                        <button type="submit" class="btn btn-primary rounded-start-0">
                            <i class="bi bi-search"></i>
                        </button>
                    </div>
                    @if (User.Identity.IsAuthenticated)
                    {
                        var role = User.FindFirst(ClaimTypes.Role)?.Value ?? "";
                        var avatarUrl = User.FindFirst("Avatar")?.Value ?? "";
                        var id = User.FindFirst("UserId")?.Value ?? "";

                        <div class="dropdown me-4">
                            <a class="d-flex align-items-center text-decoration-none dropdown-toggle" href="#" role="button" id="avatarDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                                <img src="@avatarUrl" alt="Avatar" class="rounded-circle" width="40" height="40" />
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="avatarDropdown">
                                <li><a class="dropdown-item" asp-controller="Account" asp-action="Profile" asp-route-id="@id">Profile</a></li>
                                @if (role == "Admin")
                                {
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="Dashboard">Admin Dashboard</a></li>
                                }
                                <li><hr class="dropdown-divider" /></li>
                                <li><a class="dropdown-item text-danger" asp-controller="Account" asp-action="Logout">Logout</a></li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex">
                            <a class="btn btn-outline-primary" asp-controller="Account" asp-action="Login">Login</a>
                            <a class="btn btn-outline-primary ms-2" asp-controller="Account" asp-action="Register">Register</a>
                        </div>
                            
                        
                    }
                </div>
            </div>
        </nav>
    </header>
    <main role="main" class="pb-3">
        @RenderBody()
    </main>

    <footer class="footer text-center py-2 bg-light">
        <div class="container">
            <span class="text-muted">Modern - Advanced - Smart Apartment Management System</span>
        </div>
    </footer>

    <script>
        const searchInput = document.getElementById('searchInput');

        function filterRooms() {
            const searchValue = searchInput.value.toLowerCase();

            const apartments = document.querySelectorAll('.apartment-block');

            rows.forEach(row => {
                const name = row.dataset.name;

                const matchName = name.includes(searchValue);

                if (matchName) {
                    row.style.display = "";
                } else {
                    row.style.display = "none";
                }
            });

            // 2. Kiểm tra mỗi apartment có ít nhất 1 room hiển thị
            apartments.forEach(apartment => {
                const apartmentId = apartment.dataset.apartmentId;
                const roomsInApartment = document.querySelectorAll(`.room-row[data-apartment-id="${apartmentId}"]`);
                const hasVisibleRoom = Array.from(roomsInApartment).some(r => r.style.display !== "none");

                apartment.style.display = hasVisibleRoom ? "" : "none";
            });
        }

        searchInput.addEventListener('input', filterRooms);
    </script>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

