@using System.Security.Claims
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ApartmentManagement</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ApartmentManagement.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand ms-2 fs-3" asp-controller="Room" asp-action="Index">Lucky House</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav mx-auto gap-5 fs-5">
                        <li class="nav-item">
                            <a class="nav-link text-dark " asp-controller="Room" asp-action="Index">Trang chủ</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Room" asp-action="Search">Tìm kiếm</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Room" asp-action="Contact">Liên hệ</a>
                        </li>
                    </ul>
                    @if (User.Identity.IsAuthenticated)
                    {
                        var role = User.FindFirst(ClaimTypes.Role)?.Value ?? "";
                        var avatarUrl = User.FindFirst(ClaimTypes.UserData)?.Value ?? "";
                        var id = User.FindFirst(ClaimTypes.Sid)?.Value ?? "";

                        <div class="dropdown me-4">
                            <a class="d-flex align-items-center text-decoration-none dropdown-toggle" href="#" role="button" id="avatarDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                                <img src="@avatarUrl" alt="Avatar" class="rounded-circle" width="40" height="40" />
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="avatarDropdown">
                                <li><a class="dropdown-item" asp-controller="Account" asp-action="Profile" asp-route-id="@id">Hồ sơ</a></li>
                                @if (role == "Admin")
                                {
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="Dashboard">Trang quản trị</a></li>
                                }
                                <li><hr class="dropdown-divider" /></li>
                                <li><a class="dropdown-item text-danger" asp-controller="Account" asp-action="Logout">Đăng xuất</a></li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex">
                            <a class="btn btn-outline-primary" asp-controller="Account" asp-action="Login">Đăng nhập</a>
                        </div>
                    }
                </div>
            </div>
        </nav>
    </header>
    <main role="main" class="pb-3">
         @RenderBody()
    </main>

    <footer class="footer text-center py-2 bg-light">
        <div class="container">
            <span class="text-muted">Hệ thống phòng trọ hiện đại - Tân tiến - Thông minh</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
