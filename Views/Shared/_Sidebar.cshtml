
@{
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
}
<div class="card">
    <div class="card-header fw-bold">
        MANAGEMENT
    </div>
    <div class="card-body list-group ps-3">
        <a class="list-group-item list-group-item-action @(currentAction == "Dashboard" ? "active" : "")" asp-controller="Admin" asp-action="Dashboard">
            <i class="bi bi-graph-up me-2"></i>Dashboard
        </a>
        <a class="list-group-item list-group-item-action @(currentAction == "Account" ? "active" : "")" asp-controller="Admin" asp-action="Account">
            <i class="bi bi-people me-2"></i>Accounts
        </a>
        <a class="list-group-item list-group-item-action @(currentAction == "Apartment" || currentAction == "ApartmentDetail" || currentAction == "DetailRoom" ? "active" : "")" asp-controller="Admin" asp-action="Apartment">
            <i class="bi bi-house-door me-2"></i>Apartments
        </a>
        <a class="list-group-item list-group-item-action @(currentAction == "Bill" ? "active" : "")" asp-controller="Admin" asp-action="Bill">
            <i class="bi bi-receipt me-2"></i>Bills
        </a>
        <a class="list-group-item list-group-item-action @(currentAction == "Contract" ? "active" : "")" asp-controller="Admin" asp-action="Contract">
            <i class="bi bi-file-earmark-text me-2"></i>Contracts
        </a>
    </div>
</div>
