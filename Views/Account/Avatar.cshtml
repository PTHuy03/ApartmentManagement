@model ApartmentManagement.Models.User

@{
    Layout = "_Layout";
}

<div class="container mt-5">
    <!-- Cover section -->
    <div class="bg-dark text-white text-center py-5 position-relative" style="background-image: url('../img/cover.jpg'); background-size: cover; background-position: center; height: 250px;">
        <div class="position-absolute start-0 bottom-0 ms-4 mb-4 d-flex align-items-center">
            <img src="@Model.Avatar" alt="Avatar" class="rounded-circle border border-white" style="width: 100px; height: 100px;">
            <h3 class="ms-3 fw-bold">@Model.FullName</h3>
        </div>
    </div>

    <!-- Main section -->
    <div class="row mt-4">
        <!-- Sidebar -->
        <div class="col-md-3 mb-3">
            <div class="card">
                <div class="card-header fw-bold">SETTINGS</div>
                <div class="card-body list-group ps-3">
                    <a class="list-group-item list-group-item-action" asp-controller="Account" asp-action="Profile" asp-route-id="@Model.Id">
                        <i class="bi bi-person-lines-fill me-2"></i>Profile
                    </a>
                    <a class="list-group-item list-group-item-action active" asp-controller="Account" asp-action="Avatar" asp-route-id="@Model.Id">
                        <i class="bi bi-camera-fill me-2"></i>Avatar
                    </a>
                    <a class="list-group-item list-group-item-action" asp-controller="Account" asp-action="Password" asp-route-id="@Model.Id">
                        <i class="bi bi-key-fill me-2"></i>Password
                    </a>
                </div>
            </div>
        </div>

        <!-- Profile content -->
        <div class="col-md-9">
            <div class="card">
                <div class="card-header fw-bold">EDIT YOUR AVATAR</div>
                <div class="card-body">
                    <form asp-controller="Account" asp-action="UploadAvatar" asp-route-id="@Model.Id" enctype="multipart/form-data" method="post">
                        <div class="row justify-content-center">
                            <!-- Avatar Preview -->
                            <div class="col-lg-2 text-center mb-4 mb-lg-0">
                                <img id="avatarPreview" src="@Model.Avatar" alt="Avatar" class="rounded-circle border" style="width: 100px; height: 100px; border: 3px solid #ccc;" />
                            </div>

                            <!-- Upload Area -->
                            <div class="col-lg-8">
                                <div id="dropArea" class="border p-4 rounded bg-light text-center">
                                    <p class="mb-1 fw-bold">Drag your image here</p>
                                    <p class="text-muted mb-3">- or -</p>
                                    <input type="file" id="avatarFile" name="avatarFile" accept="image/*" class="form-control d-inline-block w-75 mx-auto" />
                                    <img id="previewImage" class="mt-3 rounded" style="max-width: 200px; display: none;" />
                                </div>

                                <div class="text-center mt-3">
                                    <button type="submit" class="btn btn-primary">Set as Avatar</button>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const dropArea = document.getElementById("dropArea");
        const fileInput = document.getElementById("avatarFile");
        const previewImage = document.getElementById("previewImage");
        const avatarPreview = document.getElementById("avatarPreview");

        // Highlight drop area when dragging
        ["dragenter", "dragover"].forEach(eventName => {
            dropArea.addEventListener(eventName, (e) => {
                e.preventDefault();
                e.stopPropagation();
                dropArea.classList.add("dragover");
            });
        });

        ["dragleave", "drop"].forEach(eventName => {
            dropArea.addEventListener(eventName, (e) => {
                e.preventDefault();
                e.stopPropagation();
                dropArea.classList.remove("dragover");
            });
        });

        // Handle dropped file
        dropArea.addEventListener("drop", function (e) {
            const files = e.dataTransfer.files;
            if (files.length > 0) {
                fileInput.files = files; // Gán lại vào input file để form vẫn submit được
                previewFile(files[0]);
            }
        });

        // Handle selected file
        fileInput.addEventListener("change", function () {
            if (fileInput.files.length > 0) {
                previewFile(fileInput.files[0]);
            }
        });

        function previewFile(file) {
            if (file && file.type.startsWith("image/")) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    avatarPreview.src = e.target.result;
                    previewImage.src = e.target.result;
                    previewImage.style.display = "block";
                };
                reader.readAsDataURL(file);
            }
        }
    </script>

    <style>
        #dropArea.dragover {
            border: 2px dashed #0d6efd;
            background-color: #e9f2ff;
        }
    </style>
}
