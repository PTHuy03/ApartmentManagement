@model ApartmentManagement.Models.User

<div class="container mt-5" style="max-width: 800px;">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <h2 class="mb-4 text-center">Đăng Ký Tài Khoản</h2>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger">
                    @Html.ValidationSummary()
                </div>
            }

            <form method="post" class="border p-4 rounded shadow-sm bg-light">
                <div class="mb-3">
                    <label asp-for="FullName" class="form-label">Họ tên</label>
                    <input asp-for="FullName" class="form-control" placeholder="Nhập tên của bạn" required />
                    <span asp-validation-for="FullName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label">Email</label>
                    <input asp-for="Email" class="form-control" type="email" placeholder="Nhập email của bạn" required />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="PhoneNumber" class="form-label">Số điện thoại</label>
                    <input asp-for="PhoneNumber" class="form-control" placeholder="Nhập số điện thoại của bạn" required />
                    <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="PasswordHash" class="form-label">Mật khẩu</label>
                    <input asp-for="PasswordHash" class="form-control" type="password" placeholder="Nhập mật khẩu của bạn" required />
                    <span asp-validation-for="PasswordHash" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label class="form-label">Xác nhận mật khẩu</label>
                    <input class="form-control" type="password" id="confirmPassword" name="confirmPass" placeholder="Nhập mật khẩu xác nhận của bạn" required />
                    @if (ViewData.ModelState["ConfirmPass"] != null)
                    {
                        <div class="text-danger mt-1">
                            @ViewData.ModelState["ConfirmPass"].Errors[0].ErrorMessage
                        </div>
                    }
                </div>


                <div class="d-grid">
                    <button type="submit" class="btn btn-primary">Đăng ký</button>
                </div>
            </form>
            <div class="text-center mt-3">
                <span>Bạn đã có tài khoản?</span> <a asp-controller="Account" asp-action="Login" class="text-decoration-none">Đăng nhập ngay</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
