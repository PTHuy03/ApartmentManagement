@model ApartmentManagement.Models.User

@{
    ViewData["Title"] = "Change Password";
}

<div class="container mt-5" style="max-width: 400px;">
    <h3 class="text-center mb-4">Please change your password</h3>

    <form asp-action="ForceChangePasswordPost" method="post">
        <input type="hidden" name="id" value="@Model.Id" />
        <input type="hidden" name="rememberMe" value="@ViewBag.RememberMe" />

        <div class="mb-3">
            <label class="form-label">New Password</label>
            <input type="password" name="newPassword" class="form-control" required />
        </div>

        <div class="mb-3">
            <label class="form-label">Confirm New Password</label>
            <input type="password" name="confirmPassword" class="form-control" required />
        </div>

        <button type="submit" class="btn btn-primary w-100">Update Password</button>
    </form>
</div>
