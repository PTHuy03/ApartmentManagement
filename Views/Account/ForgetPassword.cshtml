@{
    ViewData["Title"] = "Quên mật khẩu";
}

<div class="container mt-5" style="max-width: 400px;">
    <h2 class="text-center mb-4">Quên mật khẩu</h2>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            @Html.ValidationSummary()
        </div>
    }

    <form method="post" class="border p-4 rounded shadow-sm bg-light">
        <div class="mb-3">
            <label class="form-label">Email đã đăng ký</label>
            <input name="email" type="email" class="form-control" placeholder="Nhập email của bạn" required />
        </div>

        <button type="submit" class="btn btn-primary w-100">Gửi mật khẩu mới</button>
    </form>

    <div class="text-center mt-3">
        <a asp-controller="Account" asp-action="Login" class="text-decoration-none">Quay lại đăng nhập</a>
    </div>
</div>
