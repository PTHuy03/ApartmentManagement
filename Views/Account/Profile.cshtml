@model ApartmentManagement.Models.User

@{
    Layout = "_Layout";  // Nếu bạn sử dụng layout chung
}

<div class="container mt-3 mb-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg">
                <div class="card-header bg-primary text-white">
                    <h3 class="text-center">Thông Tin Người Dùng</h3>
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-center mb-4">
                        <img src="@Model.Avatar" alt="Avatar" class="rounded-circle" width="120" height="120" />
                    </div>

                    <div class="mb-3">
                        <h5><strong>Họ và tên:</strong></h5>
                        <p>@Model.FullName</p>
                    </div>

                    <div class="mb-3">
                        <h5><strong>Email:</strong></h5>
                        <p>@Model.Email</p>
                    </div>

                    <div class="mb-3">
                        <h5><strong>Số điện thoại:</strong></h5>
                        <p>@Model.PhoneNumber</p>
                    </div>

                    <div class="mb-3">
                        <h5><strong>Vai trò:</strong></h5>
                        <p>@Model.Role</p>
                    </div>

                    <div class="mb-3">
                        <h5><strong>Trạng thái:</strong></h5>
                        <p>@(Model.Status ? "Đã có hợp đồng" : "Chưa có hợp đồng")</p>
                    </div>

                    <!-- Button Edit Profile -->
                    <div class="text-center mt-4">
                        <a class="btn btn-warning" asp-action="EditProfile" asp-route-email="@Model.Email">Chỉnh sửa hồ sơ</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
