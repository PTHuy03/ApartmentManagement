@model ApartmentManagement.Models.User

@{
    Layout = "_Layout";  // If you're using a shared layout
}

<div class="container mt-5">
    <!-- Cover section -->
    <div class="bg-dark text-white text-center py-5 position-relative" style="background-image: url('../img/cover.jpg'); background-size: cover; background-position: center; height: 250px;">
        <div class="position-absolute start-0 bottom-0 ms-4 mb-4 d-flex align-items-center">
            <img src="@Model.Avatar" alt="Avatar" class="rounded-circle border border-white" style="width: 100px; height: 100px;">
            <h3 class="ms-3 fw-bold">@Model.FullName</h3>
        </div>
    </div>

    <!-- Main section -->
    <div class="row mt-4">
        <!-- Sidebar -->
        <div class="col-md-3 mb-3">
            <div class="card">
                <div class="card-header fw-bold">
                    SETTINGS
                </div>
                <div class="card-body list-group ps-3">
                    <a class="list-group-item list-group-item-action" asp-controller="Account" asp-action="Profile" asp-route-id="@Model.Id">
                        <i class="bi bi-person-lines-fill me-2"></i>Profile
                    </a>
                    <a class="list-group-item list-group-item-action" asp-controller="Account" asp-action="Avatar" asp-route-id="@Model.Id">
                        <i class="bi bi-camera-fill me-2"></i>Avatar
                    </a>
                    <a class="list-group-item list-group-item-action active" asp-controller="Account" asp-action="Password" asp-route-id="@Model.Id">
                        <i class="bi bi-key-fill me-2"></i>Password
                    </a>
                </div>
            </div>
        </div>

        <!-- Profile content -->
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger">
                @Html.ValidationSummary()
            </div>
        }

        <div class="col-md-9">
            <div class="card">
                <div class="card-header fw-bold">
                    CHANGE YOUR PASSWORD
                </div>
                <div class="row items-push">
                    <div class="col-lg-3 m-3">
                        <p>
                            Keep your account secure by changing your password regularly.
                        </p>
                    </div>
                    <div class="card-body col-lg-7 me-5">
                        <form method="post">
                            <div class="mb-3">
                                <label class="form-label">Current Password</label>
                                <input class="form-control" type="password" id="oldPassword" name="oldPassword" required />
                                @if (ViewData.ModelState["OldPassword"] != null)
                                {
                                    <div class="text-danger mt-1">
                                        @ViewData.ModelState["OldPassword"].Errors[0].ErrorMessage
                                    </div>
                                }
                            </div>
                            <div class="mb-3">
                                <label class="form-label">New Password</label>
                                <input class="form-control" type="password" id="newPassword" name="newPassword" required />
                                @if (ViewData.ModelState["NewPassword"] != null)
                                {
                                    <div class="text-danger mt-1">
                                        @ViewData.ModelState["NewPassword"].Errors[0].ErrorMessage
                                    </div>
                                }
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Confirm New Password</label>
                                <input class="form-control" type="password" id="confirmNewPassword" name="confirmNewPassword" required />
                                @if (ViewData.ModelState["ConfirmNewPassword"] != null)
                                {
                                    <div class="text-danger mt-1">
                                        @ViewData.ModelState["ConfirmNewPassword"].Errors[0].ErrorMessage
                                    </div>
                                }
                            </div>
                            <button type="submit" class="btn btn-primary">Change Password</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}