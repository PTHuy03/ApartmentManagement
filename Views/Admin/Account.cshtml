@model List<User>
<div class="row m-4">
    <!-- Sidebar -->
    <div class="col-md-3 mb-3">
        @Html.Partial("_Sidebar")
    </div>

    <div class="col-md-9">
        <div class="card">
            <div class="card-header fw-bold">
                CUSTOMER ACCOUNT STATISTICS
            </div>
            <div class="card-body">
                @Html.AntiForgeryToken()

                <div class="table-responsive">
                    <table class="table table-bordered table-hover align-middle text-center">
                        <thead class="table-light">
                            <tr>
                                <th>Full Name</th>
                                <th>Email</th>
                                <th>Status</th>
                                <th>Role</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in Model)
                            {
                                <tr>
                                    <td>@user.FullName</td>
                                    <td>@user.Email</td>
                                    <td>
                                        @if (user.Status)
                                        {
                                            <span class="badge bg-success">Contract Signed</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">No Contract</span>
                                        }
                                    </td>
                                    <td>
                                        <select class="form-select form-select-sm w-auto mx-auto"
                                                onchange="updateRole('@user.Id', this)">
                                            <option value="Tenant" selected="@(user.Role == "Tenant")">Tenant</option>
                                            <option value="Admin" selected="@(user.Role == "Admin")">Admin</option>
                                        </select>
                                    </td>
                                    <td>
                                        <form asp-action="DeleteAccount" asp-route-id="@user.Id" method="post" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this account?')">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-danger">
                                                <i class="bi bi-trash"></i> Delete
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function updateRole(userId, selectElement) {
            const newRole = selectElement.value;

            fetch('/Admin/UpdateRole', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                },
                body: JSON.stringify({ id: userId, role: newRole })
            })
            .then(response => response.ok ? alert("Role updated successfully!") : alert("Failed to update role."))
            .catch(err => alert("Server connection error."));
        }
    </script>
}
