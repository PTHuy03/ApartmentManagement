@model List<User>
<div class="row m-4">
    <!-- Sidebar -->
    <div class="col-md-3 mb-3">
        <div class="card">
            <div class="card-header fw-bold">
                QUẢN LÝ
            </div>
            <div class="card-body list-group ps-3">
                <a class="list-group-item list-group-item-action" asp-controller="Admin" asp-action="Dashboard">
                    <i class="bi bi-graph-up me-2"></i>Thống kê
                </a>
                <a class="list-group-item list-group-item-action active" asp-controller="Admin" asp-action="Account">
                    <i class="bi bi-people-fill me-2"></i>Tài khoản
                </a>
                <a class="list-group-item list-group-item-action" asp-controller="Admin" asp-action="Room">
                    <i class="bi bi-house-door me-2"></i>Phòng
                </a>
                <a class="list-group-item list-group-item-action" asp-controller="Admin" asp-action="Bill">
                    <i class="bi bi-receipt me-2"></i>Hóa đơn
                </a>
                <a class="list-group-item list-group-item-action" asp-controller="Admin" asp-action="Contract">
                    <i class="bi bi-file-earmark-text me-2"></i>Hợp đồng
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-9">
        <div class="card">
            <div class="card-header fw-bold">
                THỐNG KÊ TÀI KHOẢN KHÁCH HÀNG
            </div>
            <div class="card-body">
                <form asp-controller="Admin" asp-action="Account" method="post">
                    @Html.AntiForgeryToken()

                    <div class="table-responsive">
                        <table class="table table-bordered table-hover align-middle text-center">
                            <thead class="table-light">
                                <tr>
                                    <th>Họ tên</th>
                                    <th>Email</th>
                                    <th>Trạng thái</th>
                                    <th>Vai trò</th>
                                    <th>Hành động</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var user in Model)
                                {
                                    <tr>
                                        <td>@user.FullName</td>
                                        <td>@user.Email</td>
                                        <td>
                                            @if (user.Status)
                                            {
                                                <span class="badge bg-success">Đã có hợp đồng</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Chưa có hợp đồng</span>
                                            }
                                        </td>
                                        <td>
                                            <select class="form-select form-select-sm w-auto mx-auto"
                                                    onchange="updateRole('@user.Id', this)">
                                                <option value="Tenant" selected="@(user.Role == "Tenant")">Khách hàng</option>
                                                <option value="Admin" selected="@(user.Role == "Admin")">Admin</option>
                                            </select>
                                        </td>
                                        <td>
                                            <a asp-action="Delete" asp-route-id="@user.Id" class="btn btn-sm btn-danger" onclick="return confirm('Bạn có chắc muốn xóa?')">
                                                <i class="bi bi-trash"></i> Xóa
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        function updateRole(userId, selectElement) {
            const newRole = selectElement.value;

            fetch('/Admin/UpdateRole', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                },
                body: JSON.stringify({ id: userId, role: newRole })
            })
            .then(response => response.ok ? alert("Cập nhật vai trò thành công!") : alert("Lỗi khi cập nhật vai trò."))
            .catch(err => alert("Lỗi kết nối máy chủ."));
        }
    </script>
}