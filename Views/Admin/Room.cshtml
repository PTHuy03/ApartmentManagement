@model List<Room>
<div class="row m-4">
    <!-- Sidebar -->
    <div class="col-md-3 mb-3">
        <div class="card">
            <div class="card-header fw-bold">
                QUẢN LÝ
            </div>
            <div class="card-body list-group ps-3">
                <a class="list-group-item list-group-item-action" asp-controller="Admin" asp-action="Dashboard">
                    <i class="bi bi-graph-up me-2"></i>Thống kê
                </a>
                <a class="list-group-item list-group-item-action" asp-controller="Admin" asp-action="Account">
                    <i class="bi bi-people me-2"></i>Tài khoản
                </a>
                <a class="list-group-item list-group-item-action active" asp-controller="Admin" asp-action="Room">
                    <i class="bi bi-house-door-fill me-2"></i>Phòng
                </a>
                <a class="list-group-item list-group-item-action" asp-controller="Admin" asp-action="Bill">
                    <i class="bi bi-receipt me-2"></i>Hóa đơn
                </a>
                <a class="list-group-item list-group-item-action" asp-controller="Admin" asp-action="Contract">
                    <i class="bi bi-file-earmark-text me-2"></i>Hợp đồng
                </a>
            </div>

        </div>
    </div>

    <div class="col-md-9">
        <div class="card">
            <div class="card-header fw-bold">
                QUẢN LÝ PHÒNG
            </div>
            <div class="card-body">
                <div class="mb-3 d-flex flex-wrap justify-content-between align-items-center">
                    <div class="d-flex flex-wrap gap-2">
                        <select class="form-select w-auto" id="filterRoomMember" onchange="filterRooms()">
                            <option value="">Số lượng người</option>
                            @foreach (var member in Model.Select(r => r.RoomMember).Distinct())
                            {
                                <option value="@member">@member người</option>
                            }
                        </select>

                        <select class="form-select w-auto" id="filterDistrict" onchange="filterRooms()">
                            <option value="">Quận</option>
                            @foreach (var district in Model.Select(r => r.District).Distinct())
                            {
                                <option value="@district">@district</option>
                            }
                        </select>

                        <select class="form-select w-auto" id="filterPrice" onchange="filterRooms()">
                            <option value="">Giá</option>
                            <option value="0-1000000">Dưới 1 triệu</option>
                            <option value="1000000-3000000">1 - 3 triệu</option>
                            <option value="3000000-999999999">Trên 3 triệu</option>
                        </select>
                    </div>

                    <a asp-controller="Admin" asp-action="CreateRoom" class="btn btn-primary">
                        <i class="bi bi-plus-lg me-1"></i> Thêm phòng
                    </a>
                </div>


                <div class="row row-cols-1 row-cols-md-3 g-4" id="roomList">
                    @foreach (var room in Model)
                    {
                        <div class="col room-card"
                             data-member="@room.RoomMember"
                             data-district="@room.District"
                             data-price="@room.Price">
                            <div class="card shadow-sm h-100">
                                <img src="@(room.ImageUrls.FirstOrDefault() ?? "/img/default-room.jpg")"
                                     class="card-img-top"
                                     alt="Ảnh phòng"
                                     style="height: 180px; object-fit: cover;">

                                <div class="card-body d-flex flex-column">
                                    <h5 class="card-title">@room.RoomName</h5>
                                    <p class="card-text text-muted mb-2">@room.Price.ToString("N0") VNĐ</p>

                                    <div class="d-flex justify-content-between small text-muted">
                                        <span><i class="bi bi-people-fill me-1"></i>@room.RoomMember người</span>
                                        <span><i class="bi bi-geo-alt-fill me-1"></i>@room.District</span>
                                    </div>

                                    <a asp-controller="Admin"
                                       asp-action="DetailRoom"
                                       asp-route-id="@room.Id"
                                       class="btn btn-sm btn-outline-primary mt-3 w-100">Chi tiết</a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        function filterRooms() {
            const memberFilter = document.getElementById("filterRoomMember").value;
            const districtFilter = document.getElementById("filterDistrict").value;
            const priceFilter = document.getElementById("filterPrice").value;

            const [priceMin, priceMax] = priceFilter ? priceFilter.split("-").map(Number) : [0, Infinity];

            document.querySelectorAll(".room-card").forEach(card => {
                const member = parseInt(card.dataset.member);
                const district = card.dataset.district;
                const price = parseFloat(card.dataset.price);

                const matchMember = !memberFilter || member == memberFilter;
                const matchDistrict = !districtFilter || district === districtFilter;
                const matchPrice = price >= priceMin && price <= priceMax;

                card.style.display = (matchMember && matchDistrict && matchPrice) ? "block" : "none";
            });
        }
    </script>
}
