## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.user
*.suo
*.userosscache
*.sln.docstates

# Build folders
/bin/
/obj/
/Debug/
/Release/
out/

# Visual Studio files
.vs/
.vscode/

# Logs
*.log

# Cache and temporary files
*.cache
*.dbmdl
*.jfm
*.tmp

# NuGet packages
*.nupkg
packages/
.nuget/

# Publish folders
publish/
wwwroot/lib/
node_modules/

# Environment & Secrets
appsettings.json
appsettings.Development.json
appsettings.*.local.json
.env

# Backup & Misc
*.bak
*.swp
*.orig

# Do NOT ignore .git folder itself
!.gitignore
!.gitattributes
